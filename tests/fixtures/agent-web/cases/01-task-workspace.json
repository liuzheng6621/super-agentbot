{
  "schema_version": "agent-web/0.1",
  "id": "agentforge/task-workspace",
  "environment": { "adapter": "agentforge-http", "seed": {}, "clock_policy": "wall" },
  "task": {
    "natural_goal": "创建任务并确认工作区可读、可写。",
    "allowed_capabilities": ["task.create", "workspace.write", "workspace.read", "task.observe"],
    "preconditions": [
      { "kind": "entity_exists", "selector": { "collection": "tasks" }, "min": 0, "max": 0 }
    ],
    "goal_assertions": [
      { "kind": "entity_exists", "selector": { "collection": "tasks" }, "min": 1 },
      {
        "kind": "field_equals",
        "selector": { "collection": "tasks", "index": 0 },
        "path": "status",
        "value": "idle"
      }
    ]
  },
  "reference_trajectory": [
    {
      "id": "s1",
      "capability": "task.create",
      "as": "owner",
      "expected_outcome": "applied",
      "arguments": { "goal": "agent-web 任务工作区验收", "flowMode": "direct", "autoRun": false }
    },
    {
      "id": "s2",
      "capability": "workspace.write",
      "as": "owner",
      "expected_outcome": "applied",
      "arguments": { "taskId": "$s1.taskId", "path": "notes.txt", "content": "hello workspace" }
    },
    {
      "id": "s3",
      "capability": "workspace.read",
      "as": "owner",
      "expected_outcome": "applied",
      "arguments": { "taskId": "$s1.taskId", "path": "notes.txt" }
    },
    {
      "id": "s4",
      "capability": "task.observe",
      "as": "owner",
      "expected_outcome": "applied",
      "arguments": { "taskId": "$s1.taskId" }
    }
  ],
  "observability": { "declared_scopes": ["tasks", "events", "exports"] }
}
