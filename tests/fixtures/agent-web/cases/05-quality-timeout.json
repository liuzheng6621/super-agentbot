{
  "schema_version": "agent-web/0.1",
  "id": "agentforge/quality-timeout",
  "environment": { "adapter": "agentforge-http", "seed": {}, "clock_policy": "wall" },
  "task": {
    "natural_goal": "质量门超过配置预算时必须终止进程并记录真实超时证据。",
    "allowed_capabilities": ["environment.prepare", "settings.update", "task.create", "task.run", "task.wait"],
    "preconditions": [
      { "kind": "entity_exists", "selector": { "collection": "tasks" }, "min": 0, "max": 0 }
    ],
    "goal_assertions": [
      { "kind": "entity_exists", "selector": { "collection": "tasks" }, "min": 1 },
      {
        "kind": "field_equals",
        "selector": { "collection": "tasks", "index": 0 },
        "path": "quality.status",
        "value": "timeout"
      },
      {
        "kind": "field_equals",
        "selector": { "collection": "tasks", "index": 0 },
        "path": "quality.timedOut",
        "value": true
      },
      {
        "kind": "payload",
        "step": 5,
        "path": "$.quality.code",
        "op": "equals",
        "value": -3
      },
      {
        "kind": "payload",
        "step": 5,
        "path": "$.quality.stdout",
        "op": "contains",
        "value": "QUALITY_TIMEOUT_MARKER"
      }
    ]
  },
  "reference_trajectory": [
    {
      "id": "s1",
      "capability": "environment.prepare",
      "as": "owner",
      "expected_outcome": "applied",
      "arguments": {
        "files": {
          "package.json": "{\"private\":true,\"scripts\":{\"test\":\"node -e \\\"console.log('QUALITY_TIMEOUT_MARKER'); setTimeout(() => {}, 30000)\\\"\"}}"
        }
      }
    },
    {
      "id": "s2",
      "capability": "settings.update",
      "as": "owner",
      "expected_outcome": "applied",
      "arguments": { "patch": { "maxRepairRounds": 0, "timeouts": { "qualityGate": 30000 } } }
    },
    {
      "id": "s3",
      "capability": "task.create",
      "as": "owner",
      "expected_outcome": "applied",
      "arguments": { "goal": "质量门真实超时验收", "flowMode": "direct", "autoRun": false }
    },
    {
      "id": "s4",
      "capability": "task.run",
      "as": "owner",
      "expected_outcome": "applied",
      "arguments": { "taskId": "$s3.taskId", "flowMode": "direct", "speed": 20 }
    },
    {
      "id": "s5",
      "capability": "task.wait",
      "as": "owner",
      "expected_outcome": "applied",
      "arguments": { "taskId": "$s3.taskId", "until": "terminal", "timeoutMs": 60000 }
    }
  ],
  "observability": { "declared_scopes": ["tasks", "events", "exports"] }
}
